# ─── Mailing / leady (Resend) ───────────────────────────────────────────
# Bez RESEND_API_KEY zapis leada działa (trafia do email_subscribers),
# ale maile sekwencji NIE są wysyłane.
# RESEND_API_KEY=re_...                    # Resend > API Keys
# Nadawca: nazwa jak od człowieka + adres na zweryfikowanej domenie w Resend.
# EMAIL_FROM=Czarek z FizykaStatkiem <hej@fizykastatkiem.pl>
# EMAIL_REPLY_TO=hej@fizykastatkiem.pl     # opcjonalnie; domyślnie jak wyżej
# UNSUB_SECRET=<długi losowy ciąg>         # podpis linków „wypisz się" (HMAC)
# CRON_SECRET=<długi losowy ciąg>          # chroni ręczne wywołanie send-sequence po HTTP

